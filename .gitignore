# TPM plugin clones — installed per-machine via `prefix + I` (see bootstrap.sh),
# not committed. Each plugin has its own .git, which would become an embedded repo if tracked.
.config/tmux/plugins/

# ~/.gitconfig is machine-local: `gh auth login` writes to it and it holds
# host-specific absolute paths. Listed here so it can't be re-added by accident.
.gitconfig

# Local scratch copy of the zshrc.local template — kept on the machine but not
# tracked; nothing in the repo references it.
zshrc.local.template
