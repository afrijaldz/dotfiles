[Unit]
Description=tmux server (detached, sessions restored by tmux-continuum)
Documentation=man:tmux(1)

[Service]
Type=forking
Environment=DISPLAY=:0
# Look tmux up on PATH via env rather than hardcoding /usr/bin/tmux: distros,
# Nix and Homebrew-on-Linux all put it somewhere different, and systemd needs
# an absolute path for the executable it launches — /usr/bin/env is the one
# path that is reliably there. ~/.local/bin is added for tmux installed there.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# `start-server` only — tmux.conf sets `exit-empty off` so the server doesn't
# die immediately before tmux-continuum gets to restore the sessions.
# Repair `last` before continuum restores from it: a save taken by the detach
# hook while the server was going down can leave it pointing at an empty or
# deleted save.
ExecStartPre=%h/.config/tmux/scripts/resurrect-repair-last.sh
ExecStart=/usr/bin/env tmux start-server

# Via the guard, NOT save.sh directly: save.sh run when the server is already dead
# writes a 0-byte save and then updates the `last` symlink to it, and the next boot's
# restore comes up empty.
ExecStop=%h/.config/tmux/scripts/resurrect-save-guard.sh
ExecStop=/usr/bin/env tmux kill-server
KillMode=control-group

RestartSec=2

[Install]
WantedBy=default.target
